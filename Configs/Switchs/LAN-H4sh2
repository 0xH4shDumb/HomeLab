set [ find default-name=ether28 ] disable-running-check=no
/interface vlan
add interface=bridge name=vlan999-mgmt vlan-id=999
/disk
set slot1 slot=slot1
set slot2 slot=slot2
/interface wireless security-profiles
set [ find default=yes ] supplicant-identity=MikroTik
/port
set 0 name=serial0
/interface bridge port
add bridge=bridge comment="Trunk to SW1" interface=ether24
add bpdu-guard=yes bridge=bridge comment="PC3 - VLAN 10" interface=ether1 pvid=10
add bpdu-guard=yes bridge=bridge comment="Web Server - VLAN 200" interface=ether2 pvid=200
add bpdu-guard=yes bridge=bridge comment="IT Server - VLAN 20" interface=ether3 pvid=20
add bpdu-guard=yes bridge=bridge comment="Splunk - VLAN 100" interface=ether4 pvid=100
/interface bridge vlan
add bridge=bridge comment="VLAN 10 - LAN" tagged=ether24 untagged=ether1 vlan-ids=10
add bridge=bridge comment="VLAN 20 - IT" tagged=ether24 untagged=ether3 vlan-ids=20
add bridge=bridge comment="VLAN 30 - WiFi Emp" tagged=ether24 vlan-ids=30
add bridge=bridge comment="VLAN 31 - WiFi Guest" tagged=ether24 vlan-ids=31
add bridge=bridge comment="VLAN 100 - SOC" tagged=ether24 untagged=ether4 vlan-ids=100
add bridge=bridge comment="VLAN 200 - DMZ-EXT" tagged=ether24 untagged=ether2 vlan-ids=200
add bridge=bridge comment="VLAN 201 - DMZ-INT" tagged=ether24 vlan-ids=201
add bridge=bridge comment="VLAN 999 - MGMT" tagged=bridge,ether24 vlan-ids=999
/ip address
add address=172.16.255.13/24 interface=vlan999-mgmt network=172.16.255.0
/ip dhcp-client
# DHCP client can not run on slave or passthrough interface!
add interface=ether1
/ip dns
set servers=172.16.255.254
/ip route
add dst-address=0.0.0.0/0 gateway=172.16.255.254
/ip service
set telnet disabled=yes
/system identity
set name=LAN-H4sh2
